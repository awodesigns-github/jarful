        <!-- ================= STATE MACHINE (declared before the animation) ================= -->
        <!--
          Ready: the open card, lid closed, face Waiting (frame 0 of Fold and Drop, held at speed 0).
          drop trigger: Ready -> Drop (plays once, holds on the landed pose).
          drop again, once it has finished: back to Ready.
          The noteLanded event fires as the note lands, for the app's soft haptic.
        -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineListenerSingle targetId="0:5" listenerTypeValue="click" name="Tap to drop" id="0:70">
                <ListenerViewModelChange>
                    <BindablePropertyTrigger propertyValue="1">
                        <DataBindContext sourcePathIds="0:40-0:45" propertyKey="686" direction="true"/>
                    </BindablePropertyTrigger>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineLayer name="Drop" id="0:8">
                <AnyState x="160" y="-140"/>
                <ExitState x="560" y="-140"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:9"/>
                </EntryState>
                <!-- Ready -->
                <AnimationState animationId="0:6" speed="0" reset="true" x="200" y="0" id="0:9">
                    <StateTransition stateToId="0:90">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <!-- Drop -->
                <AnimationState animationId="0:6" reset="true" x="420" y="120" id="0:90">
                    <StateTransition stateToId="0:9" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!--
          Fold and Drop (60 fps, 130 frames, about 2.2 s, plays once)
            0-15    lid lifts and tilts (250 ms, ease-out)
            10-34   fold 1: bottom half folds up       (faces swap at 22)
            36-60   fold 2: right half folds over left  (faces swap at 48; the outside is a Note slip)
            62-95   soft curve into the jar (550 ms), shrinking to slip size
            95      lands: tiny squash, face Waiting to Happy, noteLanded event, jar wobbles ±2° once
            110-126 lid comes back down
        -->
        <LinearAnimation fps="60" duration="130" name="Fold and Drop" id="0:6">

            <!-- Lid: lift and tilt, then close -->
            <KeyedObject objectId="0:110">
                <KeyedProperty property="x">
                    <KeyFrameDouble value="130" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="160" frame="8" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="215" frame="15" interpolationType="hold"/>
                    <KeyFrameDouble value="215" frame="110" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="160" frame="119" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="130" frame="126" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="y">
