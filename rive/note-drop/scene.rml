<Rive version="1" kind="fragment">
    <!--
      Jarful · NoteDrop (app version)
      Plays over the home jar: the note folds, drops through the mouth and lands exactly on the next
      slip slot, so when the app swaps back to its own jar nothing moves.
      Matches Figma "Flow 1 · 4 Drop in" + interaction notes 5 and 6.
      Jar art is converted from jarful-jar/jar-layers.svg (the Figma Jar component) with `rive svg`.
      Coordinates: the jar sits in the artboard exactly as components/jar/Jar.tsx draws it
      (viewBox 0 8 260 320), offset by (50, 260): jar point (x, y) is artboard (x + 50, y + 252).
      Draw order: first declared paints on top. The artboard is transparent.
    -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:41" styleId="0:3" width="360" height="580" name="NoteDrop" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <!-- Tap anywhere to drop (preview only; in the app the view ignores touches) -->
        <Shape x="180" y="290" name="Tap Area" id="0:5">
            <Rectangle width="360" height="580" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="00FFFFFF" name="Clear"/></Fill>
        </Shape>

        <Event name="noteLanded" id="0:60"/>
        <Event name="dropFinished" id="0:61"/>

        <!-- ================= JAR FRONT: lid, face, label, rim, highlight, outline ================= -->
