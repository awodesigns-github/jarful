    <!-- ================= DATA: what the app sets (components/jar/RiveNoteDrop.tsx) ================= -->
    <!--
      noteColour, noteTint, noteText   the note: mood colour (slip and card back), card tint (surface + ~18% mood), text
      noteInk, noteBorder              card text colour and card edge (compose's text/primary and border)
      drop                             fire to play
      slipCount                        slips already in the jar (0-36), as Jar.tsx shows them
      slip01..slip36                   each slip's colour, as Jar.tsx paints it
      landX, landY, landRot            centre (slips.ts coordinates) and angle (radians) of the next slip
      jarGlass, jarLine, labelFill     theme colours (light FFFFFF / 2E2A26 / FBF6EC, dark 2D2621 / F3EBDD / 221C18)
      labelOpacity                     1 on an empty jar, else 0
      faceOpacity                      1 to show the Figma face (the home jar has none yet)
    -->
